@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using Packing.Views.DataView;
@inject IViewLocalizer localizer
@{
    MasterDataView masterData = (MasterDataView)ViewBag.MasterData;
}
<div class="row" style="padding-top:10px">
    <div class="form-row">
        <div class="form-group col-md-1" style="padding:2px;display:none" >
            <label style="font-weight:normal">@localizer["Plant"]</label>
            <select id="selplant" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.PlantList!.Count() > 0)
                {
                    foreach (var item in masterData.PlantList!)
                    {
                        <option value="@item.PLANT">@item.PLANT_NAME</option>
                    } 
                }
               
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Line"]</label>
            <select id="selline" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.LineList!.Count() > 0)
                {
                    foreach (var item in masterData.LineList!)
                    {
                        <option value="@item.PACKING_LINE_ID">@item.PK_LINE_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["MaterialCode"]</label>
            <select id="selmatcode" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.MaterialList!.Count() > 0)
                {
                    foreach (var item in masterData.MaterialList!)
                    {
                        <option value="@item.MATERIAL_CODE">@item.MATERIAL_CODE</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-2" style="padding:2px">
            <label style="font-weight:normal">@localizer["MaterialName"]</label>
            <select id="selmatname" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.MaterialList!.Count() > 0)
                {
                    foreach (var item in masterData.MaterialList!)
                    {
                        <option value="@item.MATERIAL_NAME">@item.MATERIAL_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["BatchNo"]</label>
            <input id="txbatch" class="form-control" />
        </div>

        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Shift"]</label>
            @*tbm_pk_batch_status*@
            <select id="selshift" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.ShiftList!.Count() > 0)
                {
                    foreach (var item in masterData.ShiftList!)
                    {
                        <option value="@item.ID">@item.WORK_SHIFT</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["FromDate"] <span style="color:red;font-weight:bold"> *</span></label>
            <input id="txfromdate" class="form-control text-center" />
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["ToDate"] <span style="color:red;font-weight:bold"> *</span></label>
            <input id="txtodate" class="form-control text-center" />
        </div>
        <div class="form-group col-md-2" style="margin-bottom:0px;padding-top:27px">
            <button type="button" onclick="GetSummaryList()" class="btn btn-primary">@localizer["Search"]</button>
            <button type="button" onclick="GetExcel()" class="btn btn-secondary">@localizer["Excel"]</button>
        </div>
        <div class="form-group col-md-12" style="overflow:auto;height:80vh;border:solid thin lightgray">
            <table class="isr-table" id="tbl1">
                    <thead>
                        <tr>
                            <th style="width:120px">@localizer["MaterialCode"]</th>
                            <th>@localizer["MaterialGroup"]</th>
                            <th>@localizer["MaterialName"]</th>
                            <th style="width:120px">@localizer["Package"]</th>
                            <th style="width:120px">@localizer["MFGDate"]</th>
                            <th style="width:120px">@localizer["ExpiredDate"]</th>
                            <th style="width:100px">@localizer["Qty"]</th>
                            <th style="width:100px">@localizer["UOM"]</th>
                        </tr>
                    </thead>
                    <tbody id="summarybody">
                       
                    </tbody>
                </table>
        </div>
    </div>
</div>
<div class="modal" tabindex="-1" role="dialog" id="modalconfig">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Packing line configuration</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="showmodal(0)">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-group">
                        <label>Packing line</label>
                        <input class="form-control" id="txline" readonly />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Product Type</label>
                        <div class="form-inline">
                            <select id="seltype" style="width:100%">
                                <option>OIL</option>
                                <option>NON OIL</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Product</label>
                        <select id="selproduct" style="width:100%">
                            <option>น้ำมันดิบ(CDSBO)</option>
                            <option>น้ำมันรีไฟล์ (RBD SBO)</option>
                            <option>น้ำมันฟอกสี</option>
                            <option>เลซิทีน</option>
                            <option>กรดน้ำมันถั่วเหลือง</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Package</label>
                        <select id="selpkage" style="width:100%">
                            <option>จัมโบ (Jumbo)</option>
                            <option>เฟล็กซี่แทงค์</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>UOM</label>
                        <select id="seluom" style="width:100%">
                            <option>Flexitank</option>
                            <option>Cubic foot</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>OPEN/CLOSE</label>
                        <select id="selopen" style="width:100%">
                            <option>OPEN</option>
                            <option>CLOSE</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>PASS/HOLD</label>
                        <select id="selpass" style="width:100%">
                            <option>PASS</option>
                            <option>HOLD</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="showmodal(0)">Save changes</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="showmodal(0)">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        SetPagename('Summary Report');
    });

    function showmodal(flagshow) {
        if (flagshow == 1) {
            $('#modalconfig').show();
        } else {
            $('#modalconfig').hide();
        }
    }
    $(function () {
        var d = new Date();
        $('#txfromdate').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            orientation: "auto"
        }).datepicker("setDate", d);
    });
    $(function () {
        var d = new Date();
        $('#txtodate').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            orientation: "auto"
        }).datepicker("setDate", d);
    });

    function GetSummaryList() {
        var txt='';

        var frmdate = moment($("#txfromdate").val(), "DD-MM-YYYY").format("YYYY/MM/DD");
        var frmtodate = moment($("#txtodate").val(), "DD-MM-YYYY").format("YYYY/MM/DD");

        if (frmdate == 'Invalid date' || frmtodate == 'Invalid date') {
            Notiflix.Notify.warning('ช่วงวันที่ไม่ถูกต้อง !!!')
            return
        }


        $.post('@Url.Action("GetSummaryList", "Summary")', {
            Plant: $('#selplant').val(),
            Line: $('#selline').val(),
            MaterialCode: $('#selmatcode').val(),
            MaterialName: $('#selmatname').val(),
            BatchNo: $('#txbatch').val(),
            Shift: $('#selshift').val(),
            FromDate: moment($("#txfromdate").val(), "DD-MM-YYYY").format("YYYY/MM/DD"),
            ToDate: moment($("#txtodate").val(), "DD-MM-YYYY").format("YYYY/MM/DD")
          
        }, function (data) {
            if (data.length>0) {
                for(var i=0;i<data.length;i++){
                    var d=data[i];
                    txt += '<tr>'+
                        '<td class="text-center" > ' + d.materialCode + ' </td>' +
                        '<td>' + d.materialGroup + ' </td>' +
                        '<td> ' + d.materialName + ' </td>' +
                        '<td> ' + d.package + ' </td>' +
                        '<td class="text-center" >' + d.mfgDate + '</td>' +
                        '<td class="text-center" >' + d.expireDate + ' </td>' +
                        '<td class="text-right" >' + d.qty + ' </td>' +
                        '<td class="text-center" > ' + d.uom + ' </td>' +
                        '</tr>';
         
                }  
            }else{
                Notiflix.Notify.warning('ไม่พบข้อมูลที่ค้นหา')
            }
            $('#summarybody').html(txt);
        }).fail(function () {
            Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่');
        });
    }

    function GetExcel() {
        $.ajax({
            url: '@Url.Action("DownloadSummaryExcel", "Summary")',
            type: 'POST',
            data: {
                Plant: $('#selplant').val(),
                Line: $('#selline').val(),
                MaterialCode: $('#selmatcode').val(),
                MaterialName: $('#selmatname').val(),
                BatchNo: $('#txbatch').val(),
                Shift: $('#selshift').val(),
                FromDate: moment($("#txfromdate").val(), "DD-MM-YYYY").format("YYYY/MM/DD"),
                ToDate: moment($("#txtodate").val(), "DD-MM-YYYY").format("YYYY/MM/DD")
            },
            responseType: 'blob', // Set the response type to blob
            success: function (response) {
                // Create a Blob from the response
                var blob = new Blob([response], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

                // Create a link element and trigger the download
                var link = document.createElement('a');
                link.href = '/ExcelSummary/Summary.xlsx'
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                console.error(error);
            }
        });
  
    }
</script>