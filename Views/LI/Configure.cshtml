@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using Packing.Views.DataView;
@using Packing.vmsPackingDB;
@inject IViewLocalizer localizer
@{
    IEnumerable<ConfigureDataView> data = (IEnumerable<ConfigureDataView>)ViewBag.Data;
    tbm_pk_batch_slip BatchSlip = (tbm_pk_batch_slip)ViewBag.BatchSlip;
    IEnumerable<tbm_pk_work_shift> WorkSlift = (IEnumerable<tbm_pk_work_shift>)ViewBag.WorkSlift;
    tbm_pk_work_shift A = @WorkSlift.FirstOrDefault(x => x.ID == 1)!;
    tbm_pk_work_shift B = @WorkSlift.FirstOrDefault(x => x.ID == 2)!;
    tbm_pk_work_shift C = @WorkSlift.FirstOrDefault(x => x.ID == 3)!;
    MasterDataView masterData = (MasterDataView)ViewBag.MasterData;
}

<div class="row" style="padding-top:10px">
    <div class="form-row">
        <div class="form-group col-md-12">
            <label style="width:100%;padding:0px 0px 0px 15px;background-color:silver;border:silver thin solid">@localizer["Shift"]</label>
            <table>
                <thead>
                    <tr>
                        <th style="width:100px;min-width:100px;font-weight:normal">@localizer["ShiftName"]</th>
                        <th style="width:100px;min-width:100px;font-weight:normal">@localizer["From"]</th>
                        <th style="width:100px;min-width:100px;font-weight:normal">@localizer["To"]</th>
                        <th style="width:100px;min-width:80px;font-weight:normal"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="width:100px;min-width:100px"><input class="form-control text-center" value="เช้า" readonly /></td>
                        <td style="width:100px;min-width:100px"><input id="txtA1" value="@A.TIME_START!.Value.ToString("HH:mm")" class="form-control text-center" /></td>
                        <td style="width:100px;min-width:100px"><input id="txtA2" value="@A.TIME_END!.Value.ToString("HH:mm")" class="form-control text-center" /></td>
                    </tr>
                    <tr>
                        <td><input class="form-control text-center" value="บ่าย" readonly /></td>
                        <td><input id="txtB1" value="@B.TIME_START!.Value.ToString("HH:mm")" class="form-control text-center" /></td>
                        <td><input id="txtB2" value="@B.TIME_END!.Value.ToString("HH:mm")" class="form-control text-center" /></td>
                    </tr>
                    <tr>
                        <td><input class="form-control text-center" value="ดึก" readonly /></td>
                        <td><input id="txtC1" value="@C.TIME_START!.Value.ToString("HH:mm")" class="form-control text-center" /></td>
                        <td><input id="txtC2" value="@C.TIME_END!.Value.ToString("HH:mm")" class="form-control text-center" /></td>
                        <td><button onclick="SaveShift()" class="btn btn-primary" style="padding-top:4px;padding-bottom:4px">@localizer["Apply"]</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
 
        <div class="form-group col-md-12">
            <label style="width:100%;padding:0px 0px 0px 15px;background-color:silver;border:silver thin solid">@localizer["StickerFormat"]</label>
            <div class="form-inline">
                <label style="font-weight:normal;width:120px">@localizer["StickerWH"]</label>
                <input type="text" value="@BatchSlip.STICKER_WIDTH" id="txstickerwidth" class="form-control" style="margin-right:10px;width:50px;text-align:center" />
                <input type="text" value="@BatchSlip.STICKER_HEIGH" id="txstickerheight" class="form-control" style="width:50px;text-align:center;margin-right:5px" />
                <label style="font-weight:normal"> @localizer["Inchs"]</label>
                
                <label style="font-weight:normal;width:120px">@localizer["QRFormatWH"]</label>
                <input type="text" value="@BatchSlip.QR_CODE_WIDTH" id="txqrwidth" class="form-control" style="margin-right:10px;width:50px;text-align:center" />
                <input type="text" value="@BatchSlip.QR_CODE_HEIGHT" id="txqrheight" class="form-control" style="width:50px;text-align:center;margin-right:5px" />
                <label style="font-weight:normal"> @localizer["Inchs"]</label>

                <label style="font-weight:normal;width:80px">@localizer["FontSize"]</label>
                <input type="text" value="@BatchSlip.FONT_SIZE" id="txfontsize" class="form-control" style="margin-right:10px;width:50px;text-align:center" />

                <label style="font-weight:normal;width:140px">@localizer["RunNoFontSize"]</label>
                <input type="text" value="@BatchSlip.RUNNING_FONT_SIZE" id="txrunnofontsize" class="form-control" style="margin-right:10px;width:50px;text-align:center" />

                <label style="font-weight:normal;width:140px">@localizer["FormNoFontSize"]</label>
                <input type="text" value="@BatchSlip.FORM_NO_SIZE" id="txformno" class="form-control" style="margin-right:3px;width:50px;text-align:center" />

                <button class="btn btn-primary" onclick="SaveStickerFormat()" style="margin-left:5px;padding-top:3px;padding-bottom:3px">@localizer["Apply"]</button>
            </div>
        </div>
        <div class="form-group col-md-12">
            <label style="width:100%;padding:0px 0px 0px 15px;background-color:silver;border:silver thin solid">Packing line-Product configuration</label>
            <div class="form-inline">
                <table class="isr-table" id="tbl1">
                    <thead>
                        <tr>
                            <th style="width:80px">@localizer["Line"]</th>
                            <th>@localizer["MaterailCode"]</th>
                            <th>@localizer["MaterialName"]</th>
                            <th>@localizer["UOM"]</th>
                            <th>@localizer["Status"]</th>
                            <th>@localizer["Hold"]</th>
                            <th>@localizer["FormNo"]</th>
                            <th>@localizer["Rev"]</th>
                            <th style="width:45px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (data.Count() > 1)
                        {
                            foreach (var item in data)
                            {
                                <tr ondblclick="showmodal(1)">
                                    <td class="text-center">@item.PACKING_LINE_ID</td>
                                    <td class="text-center">@item.MATERIAL_CODE</td>
                                    <td>@item.MATERIAL_NAME</td>
                                    <td class="text-center">@item.DEFAULT_UOM</td>
                                    <td class="text-center" style="color:green">@item.STATUS_NAME</td>
                                    <td class="text-center" style="color:gold">@item.HOLD</td>
                                    <td class="text-center">@item.FORM_NO</td>
                                    <td class="text-center">@item.REV</td>
                                    <td class="text-center"><i class="fa fa-pencil-square-o" aria-hidden="true" style="color:goldenrod" onclick=" showmodal(1,'@item.MATERIAL_CODE', '@item.DEFAULT_PACKING_LINE_ID', '@item.DEFAULT_UOM', '@item.STATUS', '@item.DEFAULT_HOLD', '@item.FORM_NO','@item.REV','@item.id','@item.SLOC_ID')"></i></td>
                                </tr>
                            }
                     
                        }
                    
                   
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" tabindex="-1" role="dialog" id="modalconfig">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@localizer["MaterailConfiguration"]</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="showmodal(0)">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-group">
                        <label style="font-weight:normal">@localizer["MaterialCode"]</label>
                        <input class="form-control" id="txcode" readonly />
                    </div>
                    <div class="form-group col-md-6">
                        <label style="font-weight:normal">@localizer["Line"]</label>
                        <div class="form-inline">
                            <select id="selline" style="width:100%">
@*                                <option></option>
                                @if (masterData.LineList!.Count() > 0)
                                {
                                    foreach (var item in masterData.LineList!)
                                    {
                                        <option value="@item.PACKING_LINE_ID">@item.PK_LINE_NAME</option>
                                    }
                                }*@
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        <label style="font-weight:normal">@localizer["UOM"]</label>
                        <select id="selunit" style="width:100%">
                            <option></option>
                            @if (masterData.UomtList!.Count() > 0)
                            {
                                foreach (var item in masterData.UomtList!)
                                {
                                    <option value="@item.UOM">@item.UOM @item.UOM_NAME</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label style="font-weight:normal">@localizer["OpenClose"]</label>
                        <select id="selstatus" style="width:100%">
                            <option value="0">CLOSE</option>
                            <option value="1" selected>OPEN</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label style="font-weight:normal">@localizer["Hold"]</label>
                        <select id="selhold" style="width:100%">
                            <option></option>
                            @if (masterData.StatausList!.Count() > 0)
                            {
                                foreach (var item in masterData.StatausList!)
                                {
                                    <option value="@item.ID">@item.BATCH_STATUS</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label style="font-weight:normal">@localizer["FormNo"]</label>
                        <input class="form-control" id="txformnomat" />
                    </div>
                    <div class="form-group col-md-6">
                        <label style="font-weight:normal">@localizer["Rev"]</label>
                        <input class="form-control" id="txrev" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="SaveConfigureMaterial()">@localizer["Save"]</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="showmodal(0)">@localizer["Close"]</button>
            </div>
        </div>
    </div>
</div>
<script>
    var ID=0;
    $(document).ready(function () {
        SetPagename('Configuration');
    });

    function showmodal(flagshow, matCode, selline, selunit, selstatus, selhold, txformno, txrev, id, sloc_id) {
        if (flagshow == 1){
            ID = parseInt(id);
            $('#modalconfig').show();
            $('#txcode').val(matCode);
            $('#selline').val(selline).change();
            $('#selunit').val(selunit).change();
            $('#selstatus').val(selstatus).change();
            $('#selhold').val(selhold).change();
            $('#txformnomat').val(txformno);
            $('#txrev').val(txrev);


            $('#selline').find('option').remove().end();
            $('#selline').append('<option value=""></option>');
            $.post('@Url.Action("GetMaterialsLines", "LI")', {
                sloc_id: sloc_id
            }, function (data) {
                for (var i = 0; i < data.lines.length; i++) {
                    $('#selline').append('<option value=' + data.lines[i].packinG_LINE_ID + '>' + data.lines[i].pK_LINE_NAME + '</option>');
                }
            }).fail(function () {
                Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')
            });


        }else{
            ID=0;
            $('#modalconfig').hide();
            $('#txcode').val('');
        }
    }

    function SaveStickerFormat() {
        $.post('@Url.Action("SaveStickerFormat", "Configure")', {
            STICKER_WIDTH: $('#txstickerwidth').val(),
            STICKER_HEIGH: $('#txstickerheight').val(),
            QR_CODE_WIDTH: $('#txqrwidth').val(),
            QR_CODE_HEIGHT: $('#txqrheight').val(),
            FONT_SIZE: $('#txfontsize').val(),
            RUNNING_FONT_SIZE: $('#txrunnofontsize').val(),
            FORM_NO_SIZE: $('#txformno').val(),
        }, function (data) {
            if (data.status) {
                Notiflix.Notify.Success(data.message);
           
            } else {
                Notiflix.Notify.Failure('เกิดข้อผิดพลาด' + data.message);
            }
        }).fail(function () {
            Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')
       
        });
    }
    function SaveShift() {

        var datasave=[];
        datasave.push({
            ID:1 ,
            WORK_SHIFT: 'เช้า',
            TIME_START: $('#txtA1').val(),
            TIME_END: $('#txtA2').val(),
        })
        datasave.push({
            ID:2 ,
            WORK_SHIFT: 'บ่าย',
            TIME_START: $('#txtB1').val(),
            TIME_END: $('#txtB2').val(),
        })
        datasave.push({
            ID:3 ,
            WORK_SHIFT: 'ดึก',
            TIME_START: $('#txtC1').val(),
            TIME_END: $('#txtC2').val(),
        })
        $.post('@Url.Action("SaveShift", "Configure")', { DataSave: datasave }, function (data) {
            if (data.status) {
                Notiflix.Notify.Success(data.message);

            } else {
                Notiflix.Notify.Failure('เกิดข้อผิดพลาด' + data.message);
            }
        }).fail(function () {
            Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')

        });
    }
    function SaveConfigureMaterial() {
        $.post('@Url.Action("SaveConfigureMaterial", "Configure")', {
            id: ID,
            MATERIAL_CODE: $('#txcode').val(),
            DEFAULT_PACKING_LINE_ID: $('#selline').val(),
            DEFAULT_UOM: $('#selunit').val(),
            DEFAULT_HOLD: $('#selhold').val(),
            STATUS: $('#selstatus').val(),
            FORM_NO: $('#txformnomat').val(),
            REV: $('#txrev').val(),
        }, function (data) {
            if (data.status) {
                Notiflix.Notify.Success('บันทึกข้อมูลเสร็จสิ้น');
                //setTimeout(location.reload(), 3000);
            } else {
                Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')
            }

        }).fail(function () {
            Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')

        });
    }
</script>