@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@using Packing.Views.DataView;
@{
    MasterDataView masterData = (MasterDataView)ViewBag.MasterData;
}
<div class="row" style="padding-top:10px">
    <div class="form-row">
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Plant"]</label>
            <select id="selplant" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.PlantList!.Count() > 0)
                {
                    foreach (var item in masterData.PlantList!)
                    {
                        <option value="@item.PLANT">@item.PLANT_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Line"]</label>
            <select id="seltype" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.LineList!.Count() > 0)
                {
                    foreach (var item in masterData.LineList!)
                    {
                        <option value="@item.PACKING_LINE_ID">@item.PK_LINE_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["MaterialCode"]</label>
            <select id="selmatcode" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.MaterialList!.Count() > 0)
                {
                    foreach (var item in masterData.MaterialList!)
                    {
                        <option value="@item.MATERIAL_CODE">@item.MATERIAL_CODE</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-2" style="padding:2px">
            <label style="font-weight:normal">@localizer["MaterialName"]</label>
            <select id="selmatname" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.MaterialList!.Count() > 0)
                {
                    foreach (var item in masterData.MaterialList!)
                    {
                        <option value="@item.MATERIAL_CODE">@item.MATERIAL_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Shift"]</label>
            @*tbm_pk_batch_status*@
            <select id="selshift" class="form-control select2" style="width:100%">
                <option></option>
                @if (masterData.ShiftList!.Count() > 0)
                {
                    foreach (var item in masterData.ShiftList!)
                    {
                        <option value="@item.ID">@item.WORK_SHIFT</option>
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["MFGDate"]</label>
            <input id="txmfgdate" class="form-control text-center" />
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Line"]</label>
            <select id="seltype" class="form-control select2" style="width:100%">
                <option></option>
                <option>J</option>
                <option>K</option>
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["Status"]</label>
            @*tbm_pk_batch_status*@
            <select id="selstatus" class="form-control select2" style="width:100%">
                <option></option>
                <option>PASS</option>
                <option>HOLD</option>
                <option>REJECT</option>
            </select>
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["BatchNo"]</label>
            <input id="txbatch" class="form-control" />
        </div>
        <div class="form-group col-md-1" style="padding:2px">
            <label style="font-weight:normal">@localizer["RunNo"]</label>
            <input id="txrunno" class="form-control" />
        </div>
        <div class="form-group col-md-1" style="margin-bottom:0px;padding-top:27px">
            <button type="button" onclick="GetLoaddingDataViews()" class="btn btn-primary">@localizer["Search"]</button>
            <button type="button" onclick="GetExcel()" class="btn btn-secondary">@localizer["Excel"]</button>
        </div>
        <div class="form-group col-md-12">
            <div class="form-inline">
                <table class="isr-table" id="tbl1">
                    <thead>
                        <tr>
                            <th style="width:120px">@localizer["BatchNo"]</th>
                            <th style="width:80px">@localizer["SubBatch"]</th>
                            <th>@localizer["Plant"]</th>
                            <th>@localizer["MaterialName"]</th>
                            <th>@localizer["Package"]</th>
                            <th style="width:100px">@localizer["Line"]</th>
                            <th>@localizer["MFGDate"]</th>
                            <th>@localizer["RunNo"]</th>
                            <th>@localizer["Qty"]</th>
                            <th>@localizer["UOM"]</th>
                        </tr>
                    </thead>
                    <tbody id="loadingbody">
                       
                       
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" tabindex="-1" role="dialog" id="modalconfig">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Packing line configuration</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="showmodal(0)">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-group">
                        <label>Packing line</label>
                        <input class="form-control" id="txline" readonly />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Product Type</label>
                        <div class="form-inline">
                            <select id="seltype" style="width:100%">
                                <option>OIL</option>
                                <option>NON OIL</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Product</label>
                        <select id="selproduct" style="width:100%">
                            <option>น้ำมันดิบ(CDSBO)</option>
                            <option>น้ำมันรีไฟล์ (RBD SBO)</option>
                            <option>น้ำมันฟอกสี</option>
                            <option>เลซิทีน</option>
                            <option>กรดน้ำมันถั่วเหลือง</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Package</label>
                        <select id="selpkage" style="width:100%">
                            <option>จัมโบ (Jumbo)</option>
                            <option>เฟล็กซี่แทงค์</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>UOM</label>
                        <select id="seluom" style="width:100%">
                            <option>Flexitank</option>
                            <option>Cubic foot</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>OPEN/CLOSE</label>
                        <select id="selopen" style="width:100%">
                            <option>OPEN</option>
                            <option>CLOSE</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>PASS/HOLD</label>
                        <select id="selpass" style="width:100%">
                            <option>PASS</option>
                            <option>HOLD</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="showmodal(0)">Save changes</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="showmodal(0)">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        SetPagename('Loading List');
    });

    function showmodal(flagshow) {
        if (flagshow == 1) {
            $('#modalconfig').show();
        } else {
            $('#modalconfig').hide();
        }
    }

    function editData(batchno,subbath) {
        location.href = '@Url.Action("Li", "LI")?id=' + batchno;
    }
    $(function () {
        var d = new Date();
        $('#txmfgdate').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            orientation: "auto"
        }).datepicker("setDate", d);
    });

    function GetLoaddingDataViews() {
        var txt = '';
        $.post('@Url.Action("GetLoaddingDataViews", "LoadingList")', {
            Plant: $('#selplant').val(),
            Line: $('#selline').val(),
            MaterialCode: $('#selmatcode').val(),
            MaterialName: $('#selmatname').val(),
            BatchNo: $('#txbatch').val(),
            Shift: $('#selshift').val(),
            FromDate: moment($("#txfromdate").val(), "DD-MM-YYYY").format("YYYY/MM/DD"),
            ToDate: moment($("#txtodate").val(), "DD-MM-YYYY").format("YYYY/MM/DD")
        }, function (data) {
            if (data.length > 0) {
                for (var i = 0; i < data.length; i++) {
                    var d = data[i];
                    txt += ' <tr ondblclick="editData(' + d.batchNo + ',' + d.subBatch + ')">' +
                        '<td class="text-center" > ' + d.batchNo + ' </td>' +
                        '<td class="text-center" > ' + d.subBatch + ' </td>' +
                        '<td class="text-center" > ' + d.plant + ' </td>' +
                        '<td>' + d.MaterialName + '</td>' +
                        '<td class="text-center" > ' + d.package + '</td>' +
                        '<td class="text-center" > ' + d.line + ' </td>' +
                        '<td class="text-center" > ' + d.mFGDate + ' </td>' +
                        '<td class="text-center" > ' + d.runNo + ' </td>' +
                        '<td class="text-right" > ' + d.qty + ' </td>' +
                        '<td class="text-center" > ' + d.uOM + ' </td>' +
                        '</tr>';

                }
                $('#loadingbody').html(txt);
            } else {
                Notiflix.Notify.warning('ไม่พบข้อมูลที่ค้นหา')
            }
        }).fail(function () {
            Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')

        });
    }

    function GetExcel() {
     
        $.post('@Url.Action("DownloadLoaddingExcel", "LoadingList")', {
            Plant: $('#selplant').val(),
            Line: $('#selline').val(),
            MaterialCode: $('#selmatcode').val(),
            MaterialName: $('#selmatname').val(),
            BatchNo: $('#txbatch').val(),
            Shift: $('#selshift').val(),
            FromDate: moment($('#txfromdate').val(), "dd/mm/yyyy").toDate(),
            ToDate: moment($('#txtodate').val(), "dd/mm/yyyy").toDate()
        }, function (data) {
      
        }).fail(function () {
            Notiflix.Notify.Failure('เกิดข้อผิดพลาด ตรวจสอบข้อมูลใหม่')

        });
    }
</script>